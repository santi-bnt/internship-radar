# Shared development defaults
DATABASE_URL=postgresql+psycopg://internship:internship@db:5432/internship_radar
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
SCHEDULER_ENABLED=false
SCHEDULER_HOUR=7
SEARCH_SCHEDULER_ENABLED=false
HIGH_PRIORITY_SEARCH_INTERVAL_HOURS=6
GENERAL_SEARCH_INTERVAL_HOURS=24
VERIFY_JOBS_INTERVAL_HOURS=24
EXPIRE_JOBS_INTERVAL_HOURS=24
REQUEST_TIMEOUT_SECONDS=15
SOURCE_RATE_LIMIT_SECONDS=0.25
MISSING_REFRESHES_BEFORE_CLOSE=3
EMBEDDED_JOBS_MAX_DETAILS=20
EMBEDDED_JOBS_DELAY_SECONDS=0.8
COMMUNITY_SOURCE_STALE_DAYS=90
DEMO_FEED_ENABLED=false

# Email notifications
EMAIL_ENABLED=false
EMAIL_RECIPIENT=notifications@example.com
EMAIL_PROVIDER=smtp

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_NAME=Internship Radar
SMTP_FROM_EMAIL=

APP_BASE_URL=http://localhost:3000
EMAIL_PRIORITY_ALERTS=true
EMAIL_DAILY_DIGEST=false
EMAIL_DEADLINE_ALERTS=false
EMAIL_FOLLOW_UP_ALERTS=false
EMAIL_STATUS_CHANGE_ALERTS=false
EMAIL_DIGEST_HOUR=8
USER_TIMEZONE=America/Mexico_City

# Private BFF and tailored resumes
FASTAPI_INTERNAL_URL=http://backend:8000
INTERNAL_API_URL=http://backend:8000
INTERNAL_API_SECRET=
USER_IDENTITY_SIGNING_SECRET=
PRIMARY_USER_ID=
AUTHORIZED_USER_EMAILS=first.allowed@example.com,second.allowed@example.com
# Optional JSON email-to-user-ID map. Set identically in frontend and backend.
CANDIDATE_ACCOUNT_IDS=
APP_ACCESS_ENABLED=false
RESUME_EMAIL=resume@example.com
NOTIFICATION_EMAIL=notifications@example.com
RESUME_GENERATION_PROVIDER=local
OPENAI_API_KEY=
OPENAI_RESUME_MODEL=gpt-5.6
OPENAI_TIMEOUT_SECONDS=60
AI_MODE=BALANCED
LOCAL_AI_BASE_URL=http://127.0.0.1:11434
LOCAL_AI_MODEL=qwen2.5:7b-instruct
LOCAL_AI_TIMEOUT_SECONDS=20
EXTERNAL_AI_MODEL=gpt-5.6
AI_MAX_ATTEMPTS=4
# Shared by FastAPI and the Vercel BFF. Keep the same value in both deploys.
RESUME_GENERATION_LIMIT_PER_HOUR=30
# At most this many expensive LaTeX/PDF pipelines run in a backend process.
RESUME_GENERATION_GLOBAL_CONCURRENCY=2
TECTONIC_PATH=tectonic
TECTONIC_TIMEOUT_SECONDS=45

# Vercel frontend (configure in the Vercel dashboard)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Read-only public showcase. Use a separate backend and database.
PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_PUBLIC_DEMO_MODE=false
DEMO_USER_ID=public-demo
DEMO_USER_EMAIL=demo@example.com
